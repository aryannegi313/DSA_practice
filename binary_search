def binary_search(arr, target) -> int:
    left = 0
    right = len(arr) - 1
    while left<=right:
        mid = left + (right - left) // 2
        if target > arr[mid]:
            left = mid + 1
        elif target < arr[mid]:
            right = mid - 1
        elif arr[mid] == target:
            return mid
    
    return -1
arr = [1, 3, 5, 7, 9, 11]
target = 1
print(binary_search(arr, target))