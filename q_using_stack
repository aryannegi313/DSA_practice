class MyQueue:
    def __init__(self):
        self.in_stack = []
        self.out_stack = []
    
    def push(self, num:int) -> None:
        self.in_stack.append(num)
        
    def pop(self):
        if not self.out_stack:
            while self.in_stack:
                self.out_stack.append(self.in_stack.pop())
        
        return self.out_stack.pop()
        
    def peek(self):
        if not self.out_stack:
            while self.in_stack:
                self.out_stack.append(self.in_stack.pop())
                
        return self.out_stack[-1]
        
    def empty(self) -> bool:
        return len(self.in_stack) == 0 and len(self.out_stack) == 0
        
                
q = MyQueue()

q.push(10)
q.push(20)
q.push(30)

print(q.pop())   # 10
print(q.peek())  # 20
print(q.empty()) # False